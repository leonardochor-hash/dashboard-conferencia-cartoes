{
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "trocas.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/conferir.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/aprovar.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/painel2.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/trocas.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/api/conferir",
      "dest": "/api/conferir.py"
    },
    {
      "src": "/api/aprovar",
      "dest": "/api/aprovar.py"
    },
    {
      "src": "/api/painel2",
      "dest": "/api/painel2.py"
    },
    {
      "src": "/api/trocas",
      "dest": "/api/trocas.py"
    },
    {
      "src": "/trocas",
      "dest": "/trocas.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}